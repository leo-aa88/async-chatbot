# Provider API keys for a real LLM. Copy to your agent data dir as <data-dir>/.env
# (e.g. ~/.aca/.env) or to the project root, then fill in the key for the provider you
# configured in config.json's "llm". Only that provider's key is needed. .env is git-ignored,
# and an exported shell variable of the same name always takes precedence over this file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
